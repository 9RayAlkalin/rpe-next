{
  "protocol": "rpen-editor-skin",
  "version": 1,
  "id": "daybreak",
  "name": "Daybreak · 晨光",
  "author": "cmdysj / GPT",
  "description": "用于检验编辑器皮肤协议的独立亮色样例。浅蓝灰工作台、蓝色强调、轻量分组和柔和动效；不属于内置皮肤。",
  "colorScheme": "light",
  "skinVersion": "1.1.0",
  "compatibility": { "minApi": 2 },
  "preview": "preview",
  "parameters": {
    "panel-width": { "type": "number", "label": "侧栏宽度", "default": 350, "min": 260, "max": 520, "step": 10, "unit": "px" },
    "accent": { "type": "color", "label": "强调色", "default": "#2469d9" }
  },
  "assets": {
    "preview": { "type": "image", "path": "images/preview.png" },
    "mark": { "type": "image", "path": "images/mark.svg" },
    "save": { "type": "image", "path": "images/save.svg" },
    "folder": { "type": "image", "path": "images/folder.svg" },
    "sun": { "type": "image", "path": "images/sun.svg" }
  },
  "tokens": {
    "background": "#edf2f8", "surface": "#f8faff", "surface-alt": "#f0f4fa", "elevated": "#ffffff",
    "input": "#ffffff", "hover": "#e7effc", "text": "#223147", "muted": "#60738c", "border": "#c9d5e5", "border-strong": "#8ea8c9",
    "accent": "parameter(accent)", "accent-text": "#1755b5", "selected": "#e1edff", "selected-border": "#77a5e8",
    "success": "#258069", "warning": "#956716", "error": "#b83f52", "info": "#207a9b",
    "radius": "6px", "radius-panel": "12px", "font-family": "\"Segoe UI\", \"Microsoft YaHei\", sans-serif", "font-size": "13px",
    "control-padding": "6px 10px", "gap": "6px", "inspector-width": "parameter(panel-width)", "panel-shadow": "0 8px 28px #244b7422",
    "motion-fast": "110ms", "motion-normal": "160ms", "motion-easing": "cubic-bezier(0.2,0.7,0.3,1)",
    "scrollbar-thumb": "#abbdd4", "icon-filter": "brightness(0.45) saturate(1.3)"
  },
  "styles": [
    { "selector": "@header", "set": { "min-height": "54px", "border-bottom": "1px solid #d7e2f0", "box-shadow": "0 2px 8px #25476c09", "gap": "12px" } },
    { "selector": "@brand", "set": { "color": "#173655", "font-weight": "600", "letter-spacing": "-0.4px" } },
    { "selector": "@brand img", "set": { "content": "asset(mark)", "width": "32px", "height": "32px" } },
    { "selector": "@brand small", "set": { "color": "#3979cc", "letter-spacing": "1px" } },
    { "selector": "@transport", "set": { "background": "linear-gradient(100deg,#ffffff,#f2f7ff)", "padding": "10px 14px", "border-bottom": "1px solid #d5e1ee" } },
    { "selector": "button:not(.batch-ball)", "set": { "box-shadow": "0 1px 2px #18385d0a" } },
    { "selector": "button:hover:not(:disabled)", "set": { "box-shadow": "0 2px 6px #2b69b020" } },
    { "selector": "button:active:not(:disabled)", "set": { "transform": "translateY(1px)" } },
    { "selector": "@save", "set": { "border-color": "#92b4e8", "background": "#edf5ff", "color": "#1a58b3" } },
    { "selector": "@save::before,@open::before", "set": { "filter": "none" } },
    { "selector": "@file-actions", "set": { "gap": "7px", "align-items": "center", "flex-wrap": "nowrap", "min-width": "0", "overflow-x": "auto" } },
    { "selector": "[data-skin-group=project]", "set": { "padding-right": "9px", "margin-right": "2px", "border-right": "1px solid #d7e2f0", "flex-shrink": "0", "flex-wrap": "nowrap", "min-width": "max-content", "order": "-1" } },
    { "selector": "@toolbar,@editor-actions", "set": { "background": "#f7faff", "border-color": "#d4deec" } },
    { "selector": "@editor", "set": { "background": "#f5f8fd", "border-right": "1px solid #c8d7e8" } },
    { "selector": "@timeline-header", "set": { "background": "#edf3fc", "color": "#334c70", "border-color": "#cfdbeb" } },
    { "selector": "@timeline-header button", "set": { "min-height": "24px", "padding": "3px 7px" } },
    { "selector": "@inspector", "set": { "background": "#f8faff" } },
    { "selector": "@inspector-tabs", "set": { "background": "#edf3fb", "border-bottom": "1px solid #d5e1f0", "padding": "9px" } },
    { "selector": "@inspector-tabs button", "set": { "border-radius": "7px", "font-weight": "600" } },
    { "selector": ".panel-title", "set": { "background": "transparent", "border-bottom": "1px solid #d6e1ef", "font-size": "17px", "padding": "14px 14px 10px", "margin": "0 0 12px" } },
    { "selector": "[data-panel]:not([hidden])", "set": { "animation": "motion(panel-enter) var(--rpen-motion-normal) var(--rpen-motion-easing) both" } },
    { "selector": ".field", "set": { "color": "#3a506e" } },
    { "selector": ".field input:not([type=range]):not([type=checkbox]):not([type=color]),.field select,.field textarea", "set": { "background": "#ffffff", "box-shadow": "inset 0 1px 2px #233d5b06" } },
    { "selector": "@chart-tools", "set": { "gap": "8px" } },
    { "selector": "@chart-tools button", "set": { "text-align": "left", "min-height": "37px", "padding": "8px 11px" } },
    { "selector": "dialog", "set": { "border": "1px solid #bacde3", "padding": "22px" } },
    { "selector": ".settings-body h3", "set": { "color": "#254a79", "border-bottom": "1px solid #dbe5f1", "padding-bottom": "6px" } },
    { "selector": ".modal-actions,.export-footer", "set": { "border-color": "#d5e1f0", "background": "#f5f9ff" } },
    { "selector": "@footer", "set": { "background": "#eaf1fa", "border-top": "1px solid #cbd9ea", "color": "#556b87", "min-height": "27px" } },
    { "selector": "@project-home", "set": { "background": "linear-gradient(145deg,#ffffff,#eaf2fd)", "padding": "28px" } },
    { "selector": ".project-card", "set": { "border-radius": "10px", "box-shadow": "0 3px 12px #325a8410", "overflow": "hidden", "border-color": "#cbd9eb" } },
    { "selector": ".project-cover", "set": { "background": "#dce9f8" } },
    { "selector": ".project-title,.home-heading h1", "set": { "color": "#234266" } },
    { "selector": ".home-heading img", "set": { "content": "asset(mark)" } },
    { "selector": "@line-overview", "set": { "background": "#f7faffee", "border-color": "#adc7e6", "box-shadow": "var(--rpen-panel-shadow)", "border-radius": "10px" } },
    { "selector": ".line-switcher-card.selected", "set": { "box-shadow": "inset 0 0 0 1px #4c87de", "background": "#dfedff" } },
    { "selector": ".line-switcher-number,.line-switcher-line-name,.line-switcher-group", "set": { "color": "#34516f", "text-shadow": "none" } },
    { "selector": ".line-switcher-line-group,.line-group-name,.multi-line-group-name,.line-group-label", "set": { "color": "#187b87", "text-shadow": "none" } },
    { "selector": ".line-feature,.line-features,.multi-line-features,.line-list-features,.asset-row small", "set": { "text-shadow": "none", "color": "#85600f" } },
    { "selector": ".timeline-strip,#multi-line-labels,#multi-line-labels > span", "set": { "background": "#e9f0fa", "color": "#415c7d", "border-color": "#b4c7df" } },
    { "selector": ".noise-layer-panel,.batch-parameters,.asset-details,.asset-tree", "set": { "border-radius": "8px", "border-color": "#cad9eb" } },
    { "selector": "@context-menu button:hover", "set": { "background": "#e2edfc" } },
    { "selector": ".editor-notification", "set": { "border-radius": "8px", "background": "#ffffffed", "color": "#294461" } },
    { "selector": ".editor-notification.error", "set": { "background": "#fff0f1", "color": "#9b3348" } },
    { "selector": ".editor-notification.success", "set": { "background": "#effbf5", "color": "#236851" } },
    { "selector": "[data-skin-decoration=daylight]", "set": { "width": "30px", "height": "30px", "margin-right": "4px", "animation": "motion(sun-turn) 40s linear infinite", "opacity": "0.8" } },
    { "media": "(max-width: 1100px)", "rules": [
      { "selector": "@workspace", "set": { "grid-template-columns": "minmax(0,1fr) 290px" } },
      { "selector": "@header", "set": { "gap": "8px" } }
    ] },
    { "container": "(width <= 360px)", "rules": [
      { "selector": "@panel-title", "set": { "padding": "10px 12px", "font-size": "16px" } },
      { "selector": "@inspector-tabs", "set": { "padding": "6px", "gap": "3px" } },
      { "selector": "@chart-tools button", "set": { "padding": "7px 8px" } }
    ] },
    { "media": "(max-width: 700px)", "rules": [
      { "selector": "@workspace", "set": { "grid-template-columns": "minmax(0,1fr)", "grid-template-rows": "minmax(300px,3fr) minmax(150px,2fr)" } },
      { "selector": "@project-home", "set": { "padding": "12px" } },
      { "selector": "@header", "set": { "gap": "6px" } },
      { "selector": "[data-skin-decoration=daylight]", "set": { "display": "none" } }
    ] }
  ],
  "motions": {
    "panel-enter": { "from": { "opacity": "0.25", "transform": "translateY(3px)" }, "to": { "opacity": "1", "transform": "translateY(0)" } },
    "sun-turn": { "from": { "transform": "rotate(0deg)" }, "to": { "transform": "rotate(360deg)" } }
  },
  "organize": [
    { "slot": "file-actions", "id": "project", "items": ["new", "open", "save", "export"], "direction": "row" }
  ],
  "texts": [
    { "selector": "@save", "text": "保存谱面 ", "title": "将当前谱面与素材保存到本机谱面库" },
    { "selector": "@preferences", "text": "外观与设置", "title": "编辑器皮肤、热键、音频及显示设置" },
    { "selector": "@noise-fit-tool", "title": "使用矩形噪域拼合文字或图像" }
  ],
  "icons": { "save": "save", "open": "folder" },
  "decorations": [{ "id": "daylight", "target": "header", "asset": "sun" }],
  "canvas": {
    "fontScale": 1,
    "palette": {
      "#303030": "#f5f8fd", "#20252d": "#eef4fc", "#202020": "#eff4fa", "#292929": "#edf3fc", "#242628": "#e8f0fb", "#242424": "#eff4fa", "#191e27": "#eff4fa", "#edd38c": "#8c611e",
      "#555555": "#b7c8dd", "#414956": "#bdcde2", "#334154": "#d0dded", "#4e545b": "#c2d2e6", "#71767c": "#b9cbe3",
      "#7f8387": "#b3c6dd", "#8f9095": "#7195bd", "#75777c": "#abc1dc", "#dddddd": "#415a79", "#d0d0d4": "#415a79",
      "#ffffff": "#345c8f", "#f5f5f5": "#334b6b", "#d3d3d3": "#465e7c", "#cccccc": "#516b8a",
      "#00ffff": "#3087ad", "#ffff00": "#b29c54", "#80ffff": "#137f9a", "#81bfff": "#2469d9", "#ffdd77": "#af781b",
      "#e58d24": "#bd7c27", "#ffa334": "#a56620", "#6de9a4": "#218664", "#fff1d2": "#955b13", "#f3d77b": "#8c611e",
      "#f6e5ce": "#705b40", "#ffe0a3": "#825915", "#fff4c2": "#705916", "#80ffa0": "#167648", "#ffe080": "#805a12", "#efe5ff": "#654f89", "#a0ffdb": "#247959"
    }
  }
}
