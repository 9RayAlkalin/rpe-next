{
  "name": "rpe-next",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "description": "Independent, incremental Re:PhiEdit reconstruction",
  "author": "cmdysj",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://kclg-ysj.github.io/rpe-next/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kclg-YSJ/rpe-next.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:src": "tsc -p tsconfig.src.json",
    "prestart": "npm run build:src",
    "start": "node tools/serve.mjs --open",
    "copy-assets": "node tools/copy-rpe-assets.mjs",
    "generate-easings": "node tools/generate-easings.mjs",
    "serve": "node tools/serve.mjs",
    "predev": "npm run build:src",
    "dev": "vite",
    "prebuild:vite": "npm run build:src",
    "build:vite": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "pretest:ui": "npm run build:src",
    "test:ui": "vitest run",
    "pretest": "npm run build:src",
    "test": "node --test test/*.test.mjs",
    "pretest:collaboration-server": "npm run build:src",
    "test:collaboration-server": "npm --prefix collaboration-server test",
    "build:collaboration-server": "node tools/build-collaboration-server.mjs",
    "prebenchmark": "npm run build:src",
    "benchmark": "node tools/benchmark.mjs",
    "preaudit": "npm run build:src",
    "audit": "node tools/audit.mjs",
    "preverify-original": "npm run build:src",
    "verify-original": "node tools/audit.mjs --verify",
    "precompat": "npm run build:src",
    "compat": "node tools/compat.mjs",
    "prelegacy-audit": "npm run build:src",
    "legacy-audit": "node tools/legacy-audit.mjs",
    "premigration-audit": "npm run build:src",
    "migration-audit": "node tools/migration-audit.mjs",
    "prescene-audit": "npm run build:src",
    "scene-audit": "node tools/scene-audit.mjs",
    "prebuild": "npm run build:src",
    "build": "node tools/build.mjs",
    "prebuild:pages": "npm run build:src",
    "build:pages": "node tools/build.mjs --pages",
    "prebuild:desktop": "npm run build:src",
    "build:desktop": "node tools/build-desktop.mjs",
    "prebuild:release": "npm run build:src",
    "build:release": "node tools/build-release.mjs",
    "predesktop": "npm run build:src",
    "desktop": "electron desktop/main.cjs",
    "smoke-build": "node tools/smoke-build.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13",
    "yazl": "3.3.1"
  }
}
